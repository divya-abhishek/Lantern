<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- No action bar: the projector UI draws everything itself and D-pad focus is the cursor. -->
  <style name="Theme.Lantern" parent="@android:style/Theme.Material.NoActionBar">
    <item name="android:windowBackground">@color/lantern_bg</item>
    <item name="android:colorBackground">@color/lantern_bg</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowActionBar">false</item>
  </style>

  <!-- The player owns the whole display: black background, no theme chrome. -->
  <style name="Theme.Lantern.Player" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
    <item name="android:windowBackground">@color/lantern_black</item>
    <item name="android:colorBackground">@color/lantern_black</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowActionBar">false</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:windowAnimationStyle">@null</item>
  </style>
</resources>
