<UserControl x:Class="Lantern.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}"
             SizeChanged="OnSizeChanged">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock Text="Settings" Style="{StaticResource H1}" />
      <TextBlock Text="Keep it simple, but powerful." Style="{StaticResource Muted}" Margin="0,6,0,0" />

      <Grid x:Name="Layout" Margin="0,20,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="440" />
          <ColumnDefinition x:Name="GapColumn" Width="22" />
          <ColumnDefinition x:Name="SideColumn" Width="400" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition x:Name="StackRow" Height="0" />
        </Grid.RowDefinitions>

        <!-- === media folders ============================================================= -->
        <Border x:Name="FoldersCard" Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="Media folders" Style="{StaticResource H3}" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Point Lantern at the folders that hold your movies and shows. They are scanned on this PC — nothing is uploaded anywhere." />

            <!-- The path box stretches; the buttons keep their size, so nothing is ever clipped. -->
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBox Grid.Column="0" Style="{StaticResource Input}"
                       Text="{Binding NewFolderPath, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Leave empty and press Add folder to pick a folder, or type a path such as D:\Movies" />
              <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0"
                      Style="{StaticResource SecondaryButton}" Command="{Binding BrowseFolderCommand}"
                      ToolTip="Pick a folder with the Windows folder picker" />
              <Button Grid.Column="2" Content="Add folder" Margin="8,0,0,0"
                      Command="{Binding AddFolderCommand}"
                      ToolTip="Add the folder above, or pick one when the box is empty" />
              <Button Grid.Column="3" Content="{Binding ScanButtonLabel}" Margin="8,0,0,0"
                      Style="{StaticResource SecondaryButton}" Command="{Binding ScanCommand}"
                      ToolTip="Scan every watched folder for new media" />
            </Grid>

            <TextBlock Text="{Binding FolderMessage}" Margin="0,10,0,0" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding FolderMessage}" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding ScanMessage}" Margin="0,6,0,0" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ScanMessage}" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding Folders}" Margin="0,14,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                          <Run Text="{Binding MediaCount, Mode=OneWay}" /><Run Text=" title(s) · " />
                          <Run Text="{Binding TotalBytes, Mode=OneWay}" /><Run Text=" bytes" />
                        </TextBlock>
                      </StackPanel>

                      <Button Grid.Column="1" Content="Remove" VerticalAlignment="Center" Margin="12,0,0,0"
                              Style="{StaticResource DangerButton}"
                              Command="{Binding DataContext.RemoveFolderCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              ToolTip="Stop watching this folder and drop its titles" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding FoldersSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="Titles found by a scan appear in Media Library straight away, with posters, search and the resume position you left them at." />
          </StackPanel>
        </Border>

        <!-- === server + about ============================================================ -->
        <StackPanel x:Name="ServerAndAbout" Grid.Column="2">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Lantern PC" Style="{StaticResource H3}" />
              <TextBlock Text="{Binding ServerName}" Margin="0,10,0,0" FontWeight="SemiBold" />

              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                  <Ellipse.Style>
                    <Style TargetType="Ellipse">
                      <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                          <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ConnectionLabel}" Margin="8,0,0,0" Style="{StaticResource Muted}" />
              </StackPanel>

              <!-- No address, port or discovery counter here: connecting a TV or projector is done on
                   the Devices page, and it works whether or not anybody reads a number. -->
              <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,14,0,0"
                         Text="Connect a TV, phone or projector from the Devices page. Lantern finds this PC on your network on its own." />

              <Button Content="Manage Devices" Margin="0,16,0,0" HorizontalAlignment="Left"
                      Style="{StaticResource SecondaryButton}" Click="OnOpenDevices" />

              <Button Content="Refresh" Margin="0,10,0,0" HorizontalAlignment="Left"
                      Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}"
                      ToolTip="Re-read the server state, the folders and the library" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
              <TextBlock Text="About" Style="{StaticResource H3}" />
              <StackPanel Margin="0,14,0,0">
                <TextBlock Text="Lantern" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Local Cast &amp; Screen Mirror" Style="{StaticResource Caption}" />
              </StackPanel>
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"
                         Text="Movies. Shows. Your screen. No HDMI. Just Wi-Fi." />
              <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                         Text="Everything runs on your own network: no account, no cloud, no internet required." />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
