<UserControl x:Class="Lantern.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>

      <!-- Home is the three things a viewer actually does. The brand mark lives in the caption bar and
           the sidebar; no second, decorative copy of it floats here. -->
      <StackPanel>
        <TextBlock Text="{Binding Greeting}" Style="{StaticResource H1}" />
        <TextBlock Text="What do you want to cast today?" Style="{StaticResource Muted}" Margin="0,4,0,0" />
      </StackPanel>

      <!-- === the two core functions ==================================================== -->
      <Grid Margin="0,22,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="16" Padding="24" Background="{StaticResource AccentGradient}">
          <StackPanel>
            <Image Source="{StaticResource IconLibrary}" Width="34" Height="34" HorizontalAlignment="Left" />
            <TextBlock Text="Media Cast" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,0" />
            <TextBlock Text="Play movies, shows and videos directly from your PC."
                       TextWrapping="Wrap" Margin="0,6,0,0" FontSize="14" Opacity="0.92" />
            <StackPanel Margin="0,16,0,0">
              <TextBlock Text="✓  Original quality, no re-encoding" />
              <TextBlock Text="✓  Subtitles and audio tracks" Margin="0,4,0,0" />
              <TextBlock Text="✓  Low latency, instant seeking" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="Open Media" Click="OnOpenMedia" Margin="0,22,0,0"
                    HorizontalAlignment="Left" Padding="24,13" Style="{StaticResource OnAccentButton}" />
          </StackPanel>
        </Border>

        <Border Grid.Column="2" CornerRadius="16" Padding="24" Background="{StaticResource MirrorGradient}">
          <StackPanel>
            <Image Source="{StaticResource IconMirror}" Width="34" Height="34" HorizontalAlignment="Left" />
            <TextBlock Text="Screen Mirror" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,0" />
            <TextBlock Text="Mirror your Windows screen to your projector or TV."
                       TextWrapping="Wrap" Margin="0,6,0,0" FontSize="14" Opacity="0.92" />
            <StackPanel Margin="0,16,0,0">
              <TextBlock Text="✓  VLC, browser, PowerPoint, apps" />
              <TextBlock Text="✓  System audio capture" Margin="0,4,0,0" />
              <TextBlock Text="✓  Realtime, no cable" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="Open Screen Mirror" Click="OnOpenMirror" Margin="0,22,0,0"
                    HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Padding="22,12" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- === resume shelf + connected device ============================================ -->
      <Grid Margin="0,24,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Text="Continue Watching" Style="{StaticResource H2}" Margin="0,0,0,12" />

          <Border Grid.Row="1" Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                         Text="Nothing has been played yet. Open the library and press Play — the position is stored on the server, so it resumes from where you stopped.">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ContinueCount}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <ItemsControl ItemsSource="{Binding ContinueWatching}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource GhostButton}" Margin="0,0,10,10" Padding="8"
                            Command="{Binding DataContext.OpenMediaCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                      <StackPanel Width="150">
                        <Border Height="84" CornerRadius="8" Background="{StaticResource SurfaceHoverBrush}">
                          <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Text="{Binding Title}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Style="{StaticResource Progress}" Margin="0,6,0,0" Maximum="100"
                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                     Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>

        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="Connected Device" Style="{StaticResource H3}" />
            <TextBlock Text="{Binding ServerName}" FontSize="18" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsConnected}" Value="False">
                        <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding ConnectionLabel}" Margin="8,0,0,0" Style="{StaticResource Muted}" />
            </StackPanel>

            <!-- No address, port or host name on this page: the app finds the PC on its own, and the
                 manual address lives behind "Enter address" on the Devices page. -->
            <TextBlock Text="Connect a TV or projector" Style="{StaticResource Label}" Margin="0,14,0,0" />
            <TextBlock Text="Open Lantern on the TV or projector and enter the 4-digit code it shows."
                       Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />

            <Button Content="Manage Devices" Click="OnOpenDevices" Margin="0,14,0,0"
                    HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>

