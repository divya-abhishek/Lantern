<?xml version="1.0" encoding="utf-8"?>
<!--
  Lantern - Local Cast & Screen Mirror.
  The window is the product, so nothing here depends on the console server being visible.
-->
<Application x:Class="Lantern.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/LanternTheme.xaml" />
        <ResourceDictionary Source="Themes/Icons.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
