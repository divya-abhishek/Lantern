<?xml version="1.0" encoding="utf-8"?>
<!--
  Icon + logo resources.

  The Lantern mark is the official artwork, rasterised from the square master SVG
  (Assets/lantern.svg -> Assets/lantern.png, the same file the app icon is generated from). There is
  deliberately no second, hand-drawn copy of the mark in this dictionary: one logo, one source.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The square master: lamp, warm light and beam, with room for the beam on every side, so a
       square box never crops, stretches or distorts it. -->
  <BitmapImage x:Key="LanternLogo" UriSource="pack://application:,,,/Assets/lantern.png" />

  <!-- === caption-bar glyphs ========================================================= -->
  <!-- Drawn on a 12x12 grid and stroked with the button's own foreground, so the chrome follows
       the theme instead of relying on font glyphs that render differently per machine. -->
  <PathGeometry x:Key="GlyphMinimize" Figures="M1,6 L11,6" />
  <PathGeometry x:Key="GlyphMaximize"
                Figures="M1.5,1.5 L10.5,1.5 L10.5,10.5 L1.5,10.5 Z" />
  <PathGeometry x:Key="GlyphRestore"
                Figures="M3.5,1.5 L10.5,1.5 L10.5,8.5 M1.5,3.5 L8.5,3.5 L8.5,10.5 L1.5,10.5 Z" />
  <PathGeometry x:Key="GlyphClose" Figures="M1.7,1.7 L10.3,10.3 M10.3,1.7 L1.7,10.3" />
  <!-- Only the "leave fullscreen" glyph survives: fullscreen is entered by F11 or by the mirror
       player, never from a caption-bar button. -->
  <PathGeometry x:Key="GlyphFullscreenExit"
                Figures="M1.5,4 L4,4 L4,1.5 M8,1.5 L8,4 L10.5,4 M10.5,8 L8,8 L8,10.5 M4,10.5 L4,8 L1.5,8" />

  <!-- === navigation icons ============================================================ -->
  <!-- Thin strokes instead of a font glyph, so they render identically on every machine. -->
  <Pen x:Key="IconStroke" Brush="#FFE7EDFF" Thickness="1.7"
       StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />

  <DrawingImage x:Key="IconHome">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
        <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource IconStroke}">
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <LineGeometry StartPoint="3,11" EndPoint="12,4" />
              <LineGeometry StartPoint="12,4" EndPoint="21,11" />
              <LineGeometry StartPoint="5.5,9.5" EndPoint="5.5,19.5" />
              <LineGeometry StartPoint="18.5,9.5" EndPoint="18.5,19.5" />
              <LineGeometry StartPoint="5.5,19.5" EndPoint="18.5,19.5" />
              <LineGeometry StartPoint="10,19.5" EndPoint="10,14" />
              <LineGeometry StartPoint="14,19.5" EndPoint="14,14" />
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="IconLibrary">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
        <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource IconStroke}">
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <RectangleGeometry Rect="3,5 18,14" RadiusX="2" RadiusY="2" />
              <LineGeometry StartPoint="7.5,5" EndPoint="7.5,9" />
              <LineGeometry StartPoint="16.5,5" EndPoint="16.5,9" />
              <LineGeometry StartPoint="7.5,15" EndPoint="7.5,19" />
              <LineGeometry StartPoint="16.5,15" EndPoint="16.5,19" />
              <LineGeometry StartPoint="3,9" EndPoint="7.5,9" />
              <LineGeometry StartPoint="3,15" EndPoint="7.5,15" />
              <LineGeometry StartPoint="16.5,9" EndPoint="21,9" />
              <LineGeometry StartPoint="16.5,15" EndPoint="21,15" />
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="IconMirror">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
        <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource IconStroke}">
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <RectangleGeometry Rect="2.5,4.5 19,12" RadiusX="2" RadiusY="2" />
              <LineGeometry StartPoint="9,16.5" EndPoint="9,20" />
              <LineGeometry StartPoint="15,16.5" EndPoint="15,20" />
              <LineGeometry StartPoint="6,20" EndPoint="18,20" />
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="IconDevices">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
        <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource IconStroke}">
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <RectangleGeometry Rect="2.5,4.5 13,10" RadiusX="1.6" RadiusY="1.6" />
              <RectangleGeometry Rect="17,12 4.5,7.5" RadiusX="1.4" RadiusY="1.4" />
              <LineGeometry StartPoint="6,18.5" EndPoint="12.5,18.5" />
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="IconSettings">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
        <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource IconStroke}">
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <LineGeometry StartPoint="4,7" EndPoint="20,7" />
              <LineGeometry StartPoint="4,12" EndPoint="20,12" />
              <LineGeometry StartPoint="4,17" EndPoint="20,17" />
              <LineGeometry StartPoint="8.5,5" EndPoint="8.5,9" />
              <LineGeometry StartPoint="15,10" EndPoint="15,14" />
              <LineGeometry StartPoint="9.5,15" EndPoint="9.5,19" />
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="IconPlay">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
        <GeometryDrawing Brush="#FFE7EDFF" Geometry="M8,5.5 L19,12 L8,18.5 Z" />
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>

