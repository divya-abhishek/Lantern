<Window x:Class="Lantern.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lantern"
        Height="880" Width="1440" MinHeight="640" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        TextElement.Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Ideal"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Loaded="OnLoaded"
        PreviewKeyDown="OnWindowKeyDown"
        StateChanged="OnWindowStateChanged"
        DataContext="{x:Static local:App.ViewModel}"
        xmlns:local="clr-namespace:Lantern.Desktop">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" CornerRadius="0"
                  GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition x:Name="TitleBarRow" Height="46" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="248" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- === title bar ==================================================================== -->
    <Grid x:Name="TitleBar" Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource SurfaceBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
        <!-- The caption carries the name and nothing else: the one Lantern mark lives in the
             sidebar, and that same square master is the application icon. A second mark here was
             exactly the duplicate that had to go. -->
        <TextBlock Text="Lantern" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Text="Local Cast &amp; Screen Mirror" Style="{StaticResource Caption}"
                   Margin="10,0,0,0" VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="12,0,12,0" Style="{StaticResource Caption}"
                 Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                Click="OnMinimize" ToolTip="Minimize">
          <Path Data="{StaticResource GlyphMinimize}"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Button>
        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                Click="OnToggleMaximize" ToolTip="Maximize">
          <Path x:Name="MaximizeGlyph" Data="{StaticResource GlyphMaximize}"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        </Button>
        <Button x:Name="CloseWindowButton" Style="{StaticResource CloseButton}"
                Click="OnClose" ToolTip="Close">
          <Path Data="{StaticResource GlyphClose}"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- === sidebar ====================================================================== -->
    <Grid x:Name="Sidebar" Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,22,20,18">
        <Image Source="{StaticResource LanternLogo}" Width="42" Height="42" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               HorizontalAlignment="Left" VerticalAlignment="Center" />
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Lantern" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Cast What You Love" Style="{StaticResource Caption}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Row="1" Margin="12,0">
        <RadioButton x:Name="NavHome" GroupName="nav" Style="{StaticResource NavItem}"
                     IsChecked="True" Checked="OnNavChecked" Tag="home">
          <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource IconHome}" Width="18" Height="18" Margin="0,0,12,0" />
            <TextBlock Text="Home" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavLibrary" GroupName="nav" Style="{StaticResource NavItem}"
                     Checked="OnNavChecked" Tag="library">
          <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource IconLibrary}" Width="18" Height="18" Margin="0,0,12,0" />
            <TextBlock Text="Media Library" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavMirror" GroupName="nav" Style="{StaticResource NavItem}"
                     Checked="OnNavChecked" Tag="mirror">
          <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource IconMirror}" Width="18" Height="18" Margin="0,0,12,0" />
            <TextBlock Text="Screen Mirror" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavDevices" GroupName="nav" Style="{StaticResource NavItem}"
                     Checked="OnNavChecked" Tag="devices">
          <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource IconDevices}" Width="18" Height="18" Margin="0,0,12,0" />
            <TextBlock Text="Devices" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavSettings" GroupName="nav" Style="{StaticResource NavItem}"
                     Checked="OnNavChecked" Tag="settings">
          <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource IconSettings}" Width="18" Height="18" Margin="0,0,12,0" />
            <TextBlock Text="Settings" />
          </StackPanel>
        </RadioButton>
      </StackPanel>

      <Border Grid.Row="2" Margin="14,12,14,10" Padding="12" CornerRadius="12"
              Background="{StaticResource SurfaceAltBrush}"
              BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Lantern server" Style="{StaticResource Caption}" />
          <TextBlock Text="{Binding ServerName}" FontWeight="SemiBold" Margin="0,3,0,0"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                      <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding ConnectionLabel}" Margin="8,0,0,0" Style="{StaticResource Muted}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Grid.Row="3" Margin="20,0,0,14" Style="{StaticResource Caption}"
                 Text="Lantern · Local network casting" />
    </Grid>

    <!-- === page host ==================================================================== -->
    <!-- The 28px gutter lives on this grid, so a page that is capped at MaxWidth stays centred
         without ever overflowing its cell. -->
    <Grid x:Name="PageArea" Grid.Row="1" Grid.Column="1" Margin="28,18,28,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Padding="14,10" CornerRadius="{StaticResource PanelRadius}"
              Background="{StaticResource ErrorSoftBrush}"
              BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1"
              HorizontalAlignment="Stretch"
              Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFFFC9C9" TextWrapping="Wrap" MaxWidth="900" />
          <Button Content="Dismiss" Click="OnDismissError" Margin="16,0,0,0" Style="{StaticResource GhostButton}" />
        </StackPanel>
      </Border>

      <!--
        The content column is capped so cards never stretch absurdly wide on a 4K monitor, and the
        footer below it follows the same width so both stay visually aligned.
      -->
      <ContentControl x:Name="PageHost" Grid.Row="1" Margin="0,20,0,0"
                      Width="{Binding ActualWidth, ElementName=PageArea}" MaxWidth="1520"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch" />

      <StackPanel Grid.Row="2" Margin="0,14,0,14"
                  Width="{Binding ActualWidth, ElementName=PageArea}" MaxWidth="1520"
                  HorizontalAlignment="Center" Orientation="Horizontal">
        <TextBlock Text="{Binding LibrarySummary}" Style="{StaticResource Caption}" />
      </StackPanel>
    </Grid>

    <!-- === fullscreen ================================================================== -->
    <!-- The only chrome left in fullscreen: an obvious, focusable way back out (Esc works too). -->
    <Button x:Name="FullscreenExitChip" Grid.Row="0" Grid.ColumnSpan="2" Grid.RowSpan="2"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,24,0"
            Panel.ZIndex="50" Visibility="Collapsed"
            Style="{StaticResource SecondaryButton}" Click="OnExitFullscreen">
      <StackPanel Orientation="Horizontal">
        <Path Data="{StaticResource GlyphFullscreenExit}" Stroke="{StaticResource AccentBrightBrush}"
              StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <TextBlock Text="Exit fullscreen (Esc)" Margin="10,0,0,0" />
      </StackPanel>
    </Button>
  </Grid>
</Window>

